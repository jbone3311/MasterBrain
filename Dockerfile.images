# Explicit synthetic/CI raster OCR worker; never use for the public API.
FROM python:3.12-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install --no-install-recommends -y tesseract-ocr tesseract-ocr-eng \
    && test "$(tesseract --version | sed -n '1s/^tesseract //p')" = "5.5.0" \
    && test "$(dpkg-query -W -f='${Version}' tesseract-ocr-eng)" = "1:4.1.0-2" \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN pip install --no-cache-dir uv==0.12.17 && uv sync --locked --no-dev --extra image-worker --no-editable
RUN useradd --uid 10001 --create-home brain
USER 10001
ENV PATH="/app/.venv/bin:$PATH"
ENTRYPOINT ["/app/.venv/bin/python", "-I", "-B", "-m", "masterbrain.datacore.image_ocr_worker"]
